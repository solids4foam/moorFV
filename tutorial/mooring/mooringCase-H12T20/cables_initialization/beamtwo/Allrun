. $WM_PROJECT_DIR/bin/tools/RunFunctions

createBeamMesh
setInitialPositionBeam -cellZone beam_0 -translate '(0 0 0)' -rotate "((1 0 0) (0.90157487255042 -0.275354636165218 -0.333680346331657))"


touch case.foam
