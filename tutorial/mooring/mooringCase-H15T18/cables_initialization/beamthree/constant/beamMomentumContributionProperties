FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      beamMomentumContributionProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

beamMomentumContributions
(
    // Seabed contact: penalty spring/damper and Coulomb friction acting on
    // beam cells below z = groundZ
    groundContact
    {
        beamMomentumContributionType groundContact;
        groundContactCoeffs
        {
            groundZ        -0.5;    // seabed z-coordinate [m]
            kNormal        1e3;     // normal spring stiffness
            cNormal        1.0;     // normal damping
            kTangential    1e3;     // tangential (stick) stiffness
            muFriction     0.01;    // Coulomb friction coefficient
        }
    }

    // Morison drag from the line's own velocity through still water
    morisonDrag
    {
        beamMomentumContributionType morisonDrag;
        morisonDragCoeffs
        {
            Cdn       1.6;      // normal drag coefficient
            Cdt       0.05;     // tangential drag coefficient
            rhoFluid  1000;     // fluid density [kg/m^3]
        }
    }

    // Morison added mass from the line's own acceleration through still water
    morisonAddedMass
    {
        beamMomentumContributionType morisonAddedMass;
        morisonAddedMassCoeffs
        {
            CMn       1.0;      // normal added-mass coefficient
            CMt       0.0;      // tangential added-mass coefficient
            rhoFluid  1000;     // fluid density [kg/m^3]
        }
    }
);

