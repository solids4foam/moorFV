FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      W;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 0 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    right
     {
        type fixedDisplacement;
        value uniform (0 0 0);
       displacementSeries
       {
           "file"        "$FOAM_CASE/constant/timeVsDisplacement_forRight";
           outOfBounds     clamp;
       }
     }
    left
    {
        type fixedDisplacement;
        value uniform (0 0 0);
       displacementSeries
       {
           "file"        "$FOAM_CASE/constant/timeVsDisplacement";
           outOfBounds     clamp;
       }
    }



    beam
    {
        type empty;
    }
}


