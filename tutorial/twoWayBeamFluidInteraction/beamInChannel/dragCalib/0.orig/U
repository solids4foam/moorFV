FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    inlet
    {
        type            codedFixedValue;
        value           uniform (0 0 0);
        name            beamTunnelInlet_Zhang2012;

        // Zhang 2012 sec 6.4: v1f(y) = 1.5(-y^2 + 2y) [cm/s, y in cm]
        // SI (y in m):           Ux(y) = -150 y^2 + 3 y  [m/s]
        // Peak Ux = 0.015 m/s at y = H = 0.01 m
        code
        #{
            const fvPatch& p = patch();
            vectorField& Uf = *this;
            const vectorField& Cf = p.Cf();

            forAll(Uf, faceI)
            {
                const scalar y = Cf[faceI].y();
                const scalar Ux = -150.0*y*y + 3.0*y;
                Uf[faceI] = vector(Ux, 0, 0);
            }
        #};
    }
    outlet
    {
        type            zeroGradient;
    }
    lowerWall
    {
        type            noSlip;
    }
    upperWall
    {
        type            symmetry;
    }
    frontAndBack
    {
        type            symmetry;
    }
    plate
    {
        type            noSlip;
    }
}

