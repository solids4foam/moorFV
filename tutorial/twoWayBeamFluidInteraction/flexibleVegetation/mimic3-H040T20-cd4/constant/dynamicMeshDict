FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      motionProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dynamicFvMesh       dynamicMotionSolverFvMesh;

motionSolverLibs    ("libsixDoFRigidBodyBeamMotion");

motionSolver        sixDoFRigidBodyBeamMotion;

sixDoFRigidBodyBeamMotionCoeffs
{
    patches         (bottomWall);
    innerDistance   0.03;
    outerDistance   0.45;

    centreOfMass    (18.4 0.4 0.2);

    // Cuboid dimensions
    Lx              0.2;
    Ly              0.2;
    Lz              0.132;

    // Cuboid mass
    mass           3.144;

    // Cuboid moment of inertia about the centre of mass
    momentOfInertia (0 0 0);

    report          on;

    accelerationRelaxation 0.7; // this
    //accelerationDamping 0.9;

    solver
    {
        type FvBeamNewmark;
    }

   constraints
   {
      fixedOrientation
      {
          sixDoFRigidBodyBeamMotionConstraint   orientation;
          axis                              (0.0618 0.0094 -0.006);
      }
      fixedPoint
	    {
          sixDoFRigidBodyBeamMotionConstraint point;
          centreOfRotation (0 0 0);
      }
   }

   restraints
   {
       beamone
       {
           sixDoFRigidBodyBeamMotionRestraint finiteVolumeBeam;

           attachmentPatch	right;

           anchorPatch left;

           beamRegion  "beam_0";

           refAttachmentPt (18.4 0.4 0.5);
       }
   }
}

