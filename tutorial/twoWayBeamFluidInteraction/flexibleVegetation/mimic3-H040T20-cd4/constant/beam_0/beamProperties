FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      beamProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

beamModel coupledTotalLagNewtonRaphsonBeam;

beams
(
    beam_0
    {
        crossSectionModel rectangle;
        rectangleCrossSectionModelDict
        {
            b 0.008;
            h 0.0016;
            nx 1;
            ny 1;
        }
        length 0.3;
        nSegments 60;
    }
);

"coupledTotalLagNewtonRaphsonBeamCoeffs"
{
    E E [1 -1 -2 0 0 0 0] 2.2e09;
    G G [1 -1 -2 0 0 0 0] 8.27e08; // scaled from Mimic 2's G with same implied E/G (Jacobsen does not report G for any mimic)
    rho rho [1 -3 0 0 0 0 0] 1090;

    rhoFluid rhoFluid [1 -3 0 0 0 0 0] 1000;
    //- convergence check paramters----------------                                                                                                  
    nCorrectors 500;
    residualTol 1e-09;//1e-08;//1e-07;//1e-06;                                                                                                       
    solutionTol 1e-10;//1e-09;//1e-08;//1e-07;                                                                                                       
    absoluteTol 1e-10;//1e-10;//1e-09;//1e-08;                                                                                                       
    divergenceTol  1e6;
    //-------------------------
    // ALM parameters moved to constant/beamMomentumContributionProperties


}



