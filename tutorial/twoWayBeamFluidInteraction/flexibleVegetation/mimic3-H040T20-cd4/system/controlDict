FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

libs
(
    libsixDoFRigidBodyBeamMotion.so
    libsixDoFRigidBodyBeamMotionState.so
    libwireBunchingModels.so
);


application     interFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         32;

deltaT          5e-05;

writeControl    adjustableRunTime; // timeStep; //

writeInterval   0.1;

purgeWrite      60;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable no;

adjustTimeStep  yes;

maxCo           0.25;
maxAlphaCo      0.25;
maxDeltaT       5e-05;

functions
{
}

