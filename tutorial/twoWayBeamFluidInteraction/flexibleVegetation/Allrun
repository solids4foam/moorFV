#!/bin/sh
cd "${0%/*}" || exit 1                              # Run from this directory

# Fluid cases to run: all by default, or those given on the command line
cases="${*:-mimic3-H040T20-cd4}"

# Generate the beam mesh and the initial beam fields
echo "Running beamInitialisation/beam_0"
beamInitialisation/beam_0/Allrun || exit 1

for caseI in $cases
do
    # Copy the beam mesh and fields to the fluid case
    rm -rf $caseI/0.orig/beam_0 $caseI/constant/beam_0/polyMesh
    cp -r beamInitialisation/beam_0/0 $caseI/0.orig/beam_0
    cp -r beamInitialisation/beam_0/constant/polyMesh $caseI/constant/beam_0/

    # Run the fluid case
    echo "Running $caseI"
    $caseI/Allrun || exit 1
done

