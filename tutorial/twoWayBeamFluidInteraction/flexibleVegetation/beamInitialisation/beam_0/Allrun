#!/bin/sh
cd "${0%/*}" || exit 1                              # Run from this directory
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions        # Tutorial run functions

# Create the straight beam mesh and move it to its position in the fluid domain
runApplication createBeamMesh || exit 1
runApplication setInitialPositionBeam -cellZone beam_0 -translate '(18.4 0.4 0.5)' -rotate '((1 0 0) (0 0 -1))' || exit 1

touch case.foam

