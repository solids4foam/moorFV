#
# Script
#     Allrun
#
# Description
#     Mesh the channel, decompose the fluid and beam regions (whole beam on
#     processor 0), run pimpleFoam in parallel and reconstruct. Run ../Allrun
#     first to generate the beam mesh and fields.
#
#------------------------------------------------------------------------------
cd ${0%/*} || exit 1    # Run from this directory

# Source tutorial run functions
. $WM_PROJECT_DIR/bin/tools/RunFunctions

# The beam mesh and fields are generated by ../Allrun
if [ ! -d constant/beam_0/polyMesh ]
then
    echo "Beam mesh not found: run ../Allrun $(basename "$PWD") first" 1>&2
    exit 1
fi


runApplication blockMesh

restore0Dir
touch case.foam
#runApplication pimpleFoam

runApplication  decomposePar -latestTime


for beamI in constant/beam*
    do
        # Keep the whole beam on processor 0
        nCells=$(sed -n 's/.*nCells: *\([0-9]*\).*/\1/p' $beamI/polyMesh/owner)
        {
            echo 'FoamFile { version 2.0; format ascii; class labelList; object cellDecomposition; }'
            echo "$nCells"; echo "("; yes 0 | head -n "$nCells"; echo ")"
        } > $beamI/cellDecomposition
        beamNameI=$(basename $beamI)
        runApplication -s $beamNameI decomposePar -region $beamNameI -latestTime
    done

runParallel pimpleFoam

runApplication reconstructPar #-latestTime

for beamI in constant/beam*
    do
        beamNameI=$(basename $beamI)
        runApplication -s $beamNameI reconstructPar -region $beamNameI #-latestTime
    done



