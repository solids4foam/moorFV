        type    forceBeamDisplacementNR;
        force   uniform (0 0 0);
        value   uniform (0 0 0);
    }

    left
    {
        type    fixedValue;
        value   uniform (0 0 0);
        // type    fixedValue;
        // displacementSeries
        // {
        //     file        "$FOAM_CASE/constant/timeVsDisplacement";
        //     outOfBounds     clamp;
        // }
