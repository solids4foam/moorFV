FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p
    {
        solver           GAMG;
        tolerance        1e-8;
        relTol           0;
        smoother         DICGaussSeidel;
        nPreSweeps       0;
        nPostSweeps      2;
        cacheAgglomeration true;
    }

    "(pFinal|pcorrFinal)"
    {
        $p;
        relTol          0;
    }

    "(U|k|epsilon)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-8;
        relTol          0;
        nSweeps         2;
    }

    "(U|k|epsilon)Final"
    {
        $U;
        relTol          0;
    }
}

PIMPLE
{
    nNonOrthogonalCorrectors 0;
    nCorrectors              2;
    nOuterCorrectors         20;
    momentumPredictor        yes;
    moveMeshOuterCorrectors  no;

    residualControl
    {
        p { tolerance 1e-7; relTol 1e-4; }
        U { tolerance 1e-7; relTol 1e-4; }
    }
}

relaxationFactors
{
    equations
    {
        "U.*"  1.0;
        "p.*"  1.0;
    }
}


