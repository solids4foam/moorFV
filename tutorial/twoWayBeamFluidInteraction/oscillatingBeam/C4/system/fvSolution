FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p
    {
        solver           GAMG;
        tolerance        1e-7;
        relTol           0.01;
        smoother         DICGaussSeidel;
    }

    "(pFinal|pcorrFinal)"
    {
        $p;
        relTol          0;
    }

    "(U|k|epsilon)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-05;
        relTol          0.1;
    }

    "(U|k|epsilon)Final"
    {
        $U;
        relTol          0;
    }
}

PIMPLE
{
    nNonOrthogonalCorrectors 0;
    nCorrectors         3;
    nOuterCorrectors    1;//30;
    momentumPredictor yes;
    moveMeshOuterCorrectors    no;
    residualControl
    {
        p
        {
            tolerance 1e-06;
            relTol    0.01;
        }
        U
        {
            tolerance 1e-06;
            relTol    0.01;
        }
    }
}
relaxationFactors
{
    equations
    {
        U 0.8;        // 0.6–0.8 is common
        p 0.2;        // low for pressure
    }
    // fields { }   // usually leave empty for transient PIMPLE
}


